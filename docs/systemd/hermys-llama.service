# llama.cpp server — the one resident big model (two personas, one weight set).
# Flags are placeholders until bench/RESULTS.md locks them.
[Unit]
Description=Hermys LLM serving (llama.cpp, GPT-OSS-120B MXFP4)
After=network.target

[Service]
User=hermys
WorkingDirectory=/opt/hermys
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model /opt/models/gpt-oss-120b-mxfp4.gguf \
  --host 127.0.0.1 --port 8081 \
  --ctx-size 32768 --flash-attn \
  --n-gpu-layers 999
Restart=on-failure
RestartSec=5
# bandwidth is the budget: one resident, never two (build plan §4.1)

[Install]
WantedBy=multi-user.target
